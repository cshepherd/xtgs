10 DEFINT I-N:DEFDBL A-H:DEF SEG=&HF800
20 B=3.14159265358979#:C=2.71828182845905#:X!=3.141593:Y!=2.718282:N=200
30 POKE 0,1:FOR I=1 TO N:NEXT
40 POKE 0,2:FOR I=1 TO N:A=B:NEXT
50 POKE 0,3:FOR I=1 TO N:A=B+C:NEXT
60 POKE 0,4:FOR I=1 TO N:A=B*C:NEXT
70 POKE 0,5:FOR I=1 TO N:A=B/C:NEXT
80 POKE 0,6:FOR I=1 TO N:Z!=X!:NEXT
90 POKE 0,7:FOR I=1 TO N:Z!=X!+Y!:NEXT
100 POKE 0,8:FOR I=1 TO N:Z!=X!*Y!:NEXT
110 POKE 0,9:FOR I=1 TO N:Z!=X!/Y!:NEXT
120 POKE 0,10:FOR I=1 TO N:Z!=SQR(X!):NEXT
130 POKE 0,11:FOR I=1 TO N:Z!=LOG(X!):NEXT
140 POKE 0,12:FOR I=1 TO N:Z!=SIN(X!):NEXT
150 POKE 0,13:FOR I=1 TO N:Z!=EXP(X!):NEXT
160 POKE 0,255:PRINT "DONE"
